{
  "manifest_version": 3,
  "name": "Peek",
  "version": "1.0.0",
  "key": "",
  "description": "Preview links in a floating window, Arc-style. Click-with-modifier or right-click only; never on drag.",
  "permissions": [
    "declarativeNetRequest",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Peek settings",
    "default_popup": "options.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "gnews.js",
        "content.js",
        "extract.js",
        "summary.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "peek.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
